<Window x:Class="TamirciDukkani.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TamirciDukkani.Desktop"
        mc:Ignorable="d"
        Title="TKS" Height="600" Width="1000">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="ExportVehiclesCsvButton" Content="Araçları CSV Dışa Aktar" Margin="0,0,8,0" Click="ExportVehiclesCsvButton_Click"/>
                <Button x:Name="ExportVehiclesExcelButton" Content="Araçları Excel Dışa Aktar" Margin="0,0,8,0" Click="ExportVehiclesExcelButton_Click"/>
                <Button x:Name="ExportJobsCsvButton" Content="İşleri CSV Dışa Aktar" Margin="0,0,8,0" Click="ExportJobsCsvButton_Click"/>
                <Button x:Name="ExportJobsExcelButton" Content="İşleri Excel Dışa Aktar" Click="ExportJobsExcelButton_Click"/>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Araçlar">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Arama:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SearchTextBox" Width="200" Margin="0,0,8,0" />
                        <TextBlock Text="Marka:" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <TextBox x:Name="BrandFilterTextBox" Width="150" Margin="0,0,8,0" />
                        <Button x:Name="FilterButton" Content="Filtrele" Click="FilterButton_Click" />
                        <Button x:Name="ClearFilterButton" Content="Temizle" Margin="8,0,0,0" Click="ClearFilterButton_Click" />
                    </StackPanel>

                    <DataGrid x:Name="VehiclesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="VehiclesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Plaka" Binding="{Binding Plaka}" Width="120" />
                            <DataGridTextColumn Header="Marka" Binding="{Binding Marka}" Width="120" />
                            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="120" />
                            <DataGridTextColumn Header="Model Yılı" Binding="{Binding ModelYili}" Width="80" />
                            <DataGridTextColumn Header="Müşteri" Binding="{Binding MusteriAdi}" Width="*" />
                            <DataGridTextColumn Header="Telefon" Binding="{Binding MusteriTel}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="2" Header="Araç Formu" Margin="0,8,0,0">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Plaka" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" />
                            <TextBox x:Name="PlakaText" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" />

                            <TextBlock Text="Marka" Grid.Row="0" Grid.Column="3" Margin="0,0,8,8" VerticalAlignment="Center" />
                            <TextBox x:Name="MarkaText" Grid.Row="0" Grid.Column="4" Margin="0,0,8,8" />

                            <TextBlock Text="Model" Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" />
                            <TextBox x:Name="ModelText" Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" />

                            <TextBlock Text="Model Yılı" Grid.Row="1" Grid.Column="3" Margin="0,0,8,8" VerticalAlignment="Center" />
                            <TextBox x:Name="ModelYiliText" Grid.Row="1" Grid.Column="4" Margin="0,0,8,8" />

                            <TextBlock Text="Müşteri Adı" Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" />
                            <TextBox x:Name="MusteriAdiText" Grid.Row="2" Grid.Column="1" Margin="0,0,8,8" />

                            <TextBlock Text="Telefon" Grid.Row="2" Grid.Column="3" Margin="0,0,8,8" VerticalAlignment="Center" />
                            <TextBox x:Name="MusteriTelText" Grid.Row="2" Grid.Column="4" Margin="0,0,8,8" />

                            <TextBlock Text="Şasi No" Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" />
                            <TextBox x:Name="SasiNoText" Grid.Row="3" Grid.Column="1" Margin="0,0,8,8" />

                            <TextBlock Text="Notlar" Grid.Row="3" Grid.Column="3" Margin="0,0,8,8" VerticalAlignment="Center" />
                            <TextBox x:Name="NotlarText" Grid.Row="3" Grid.Column="4" Margin="0,0,8,8" />

                            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="NewButton" Content="Yeni" Width="90" Margin="0,0,8,0" Click="NewButton_Click" />
                                <Button x:Name="SaveButton" Content="Kaydet" Width="90" Margin="0,0,8,0" Click="SaveButton_Click" />
                                <Button x:Name="DeleteButton" Content="Sil" Width="90" Margin="0,0,8,0" Click="DeleteButton_Click" />
                                <Button x:Name="RefreshButton" Content="Yenile" Width="90" Click="RefreshButton_Click" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="İş Emirleri">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Ara:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="JobsSearchTextBox" Width="200" Margin="0,0,8,0"/>
                        <TextBlock Text="Durum:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <ComboBox x:Name="JobsStatusCombo" Width="150">
                            <ComboBoxItem Content="(Tümü)" IsSelected="True"/>
                            <ComboBoxItem Content="Atölyede"/>
                            <ComboBoxItem Content="Tamamlandı"/>
                            <ComboBoxItem Content="Teslim"/>
                        </ComboBox>
                        <Button Content="Filtrele" Margin="8,0,0,0" Click="JobsFilterButton_Click"/>
                        <Button Content="Temizle" Margin="8,0,0,0" Click="JobsClearFilterButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="JobsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="JobsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Araç" Binding="{Binding VehicleDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Geliş" Binding="{Binding GelisTarihi, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Çıkış" Binding="{Binding CikisTarihi, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="120"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*"/>
                            <DataGridTextColumn Header="İşçilik" Binding="{Binding IscilikTutar}" Width="90"/>
                            <DataGridTextColumn Header="Parça" Binding="{Binding ParcaTutar}" Width="90"/>
                            <DataGridTextColumn Header="Genel" Binding="{Binding GenelTutar}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="2" Header="İş Emri Formu" Margin="0,8,0,0">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Araç" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
                            <ComboBox x:Name="JobVehicleCombo" Grid.Row="0" Grid.Column="1" DisplayMemberPath="Plaka" SelectedValuePath="Id" Margin="0,0,8,8"/>

                            <TextBlock Text="Durum" Grid.Row="0" Grid.Column="3" Margin="0,0,8,8" VerticalAlignment="Center"/>
                            <ComboBox x:Name="JobStatusCombo" Grid.Row="0" Grid.Column="4" Margin="0,0,8,8">
                                <ComboBoxItem Content="Atölyede"/>
                                <ComboBoxItem Content="Tamamlandı"/>
                                <ComboBoxItem Content="Teslim"/>
                            </ComboBox>

                            <TextBlock Text="Geliş Tarihi" Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
                            <DatePicker x:Name="JobGelisDate" Grid.Row="1" Grid.Column="1" Margin="0,0,8,8"/>

                            <TextBlock Text="Çıkış Tarihi" Grid.Row="1" Grid.Column="3" Margin="0,0,8,8" VerticalAlignment="Center"/>
                            <DatePicker x:Name="JobCikisDate" Grid.Row="1" Grid.Column="4" Margin="0,0,8,8"/>

                            <TextBlock Text="Açıklama" Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
                            <TextBox x:Name="JobAciklamaText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,0,8,8"/>

                            <TextBlock Text="İşçilik Tutar" Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
                            <TextBox x:Name="JobIscilikText" Grid.Row="3" Grid.Column="1" Margin="0,0,8,8"/>

                            <TextBlock Text="Parça Tutar" Grid.Row="3" Grid.Column="3" Margin="0,0,8,8" VerticalAlignment="Center"/>
                            <TextBox x:Name="JobParcaText" Grid.Row="3" Grid.Column="4" Margin="0,0,8,8"/>

                            <TextBlock Text="Genel Tutar" Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
                            <TextBox x:Name="JobGenelText" Grid.Row="4" Grid.Column="1" Margin="0,0,8,8"/>

                            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="JobNewButton" Content="Yeni" Width="90" Margin="0,0,8,0" Click="JobNewButton_Click"/>
                                <Button x:Name="JobSaveButton" Content="Kaydet" Width="90" Margin="0,0,8,0" Click="JobSaveButton_Click"/>
                                <Button x:Name="JobDeleteButton" Content="Sil" Width="90" Margin="0,0,8,0" Click="JobDeleteButton_Click"/>
                                <Button x:Name="JobRefreshButton" Content="Yenile" Width="90" Click="JobRefreshButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="InShopCountText" Text="Atölyede: 0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="TodayDeliveriesText" Text="Bugün Teslim: 0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
